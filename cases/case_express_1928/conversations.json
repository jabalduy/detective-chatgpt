              {
                "type": "fact_found",
                "id": 6
              },
              {
                "type": "fact_found",
                "id": 7
              }
            ],
            "time_cost": 25
          },
          {
            "id": "ribbon_vs_route",
            "text": "Николя видел вас возле купе Виктора, а в купе найдена часть вашей ленты. Как это объяснить?",
            "kind": "speech",
            "next_node": "ribbon_vs_route_answer",
            "requirements": [
              {
                "type": "fact_found",
                "id": 1
              },
              {
                "type": "fact_found",
                "id": 8
              }
            ],
            "time_cost": 30
          },
          {
            "id": "leave",
            "text": "Закончить разговор",
            "kind": "action",
            "end": true,
            "time_cost": 0
          }
        ]
      },
      {
        "id": "a1",
        "text": "Работала. На этом поезде всегда кто-то требует кипятка.",
