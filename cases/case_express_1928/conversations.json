[
  {
    "id": "marta_intro",
    "character_id": 1,
    "start_node": "hello",
    "nodes": [
      {
        "id": "hello",
        "text": "Я знаю каждую дверь этого поезда. Но это не значит, что я знаю все чужие тайны.",
