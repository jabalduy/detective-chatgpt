              {
                "type": "character_trust_up",
                "id": 1
              }
            ]
          },
          {
            "id": "q2",
            "text": "Вы знали Виктора?",
            "kind": "speech",
            "next_node": "a2",
            "time_cost": 15
          },
          {
            "id": "evidence",
            "text": "В купе найдена лента, похожая на вашу. Как она там оказалась?",
